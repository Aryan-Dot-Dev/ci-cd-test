pipeline {
    agent any

    tools {
        nodejs "NodeJS"
        docker "Docker"
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Aryan-Dot-Dev/ci-cd-test.git'
            }
        }

        stage('Install') {
            steps {
                sh 'npm install'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t devops-test:latest .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker stop devops-test || true
                docker rm devops-test || true
                docker run -d -p 3000:3000 --name devops-test devops-test:latest
                '''
            }
        }
    }
}