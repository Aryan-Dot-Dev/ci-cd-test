pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        IMAGE_NAME = "devops-test"
        LOCALSTACK_URL = "http://localhost:4566"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/Aryan-Dot-Dev/ci-cd-test.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test || true'
            }
        }

        stage('Terraform Init & Apply') {
            steps {
                sh '''
                cd terraform
                terraform init
                terraform apply -auto-approve
                '''
            }
        }

        stage('Ansible Setup') {
            steps {
                sh '''
                cd ansible
                sudo ansible-playbook -i inventory setup.yml
                '''
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                sh '''
                docker build -t $IMAGE_NAME:latest .
                docker tag $IMAGE_NAME:latest localhost:4566/$IMAGE_NAME:latest
                docker push localhost:4566/$IMAGE_NAME:latest
                '''
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                docker stop $IMAGE_NAME || true
                docker rm $IMAGE_NAME || true

                docker run -d -p 3000:3000 \
                --name $IMAGE_NAME \
                localhost:4566/$IMAGE_NAME:latest
                '''
            }
        }
    }
}